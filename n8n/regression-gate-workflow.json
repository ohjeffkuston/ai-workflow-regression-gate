{
  "name": "AI Workflow Regression Gate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-workflow-regression",
        "responseMode": "lastNode"
      },
      "id": "webhook",
      "name": "Regression Suite",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "command": "printf '%s' '{{ JSON.stringify($json.body) }}' > /tmp/regression-suite.json && ai-workflow-regression-gate /tmp/regression-suite.json --compact"
      },
      "id": "evaluate",
      "name": "Offline Regression Evaluation",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "leftValue": "={{ JSON.parse($json.stdout).decision }}",
              "rightValue": "PASS",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "gate",
      "name": "Release Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { approved: true, report: JSON.parse($json.stdout) } }}"
      },
      "id": "pass",
      "name": "Approved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1040,
        220
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { approved: false, human_review_required: true, report: JSON.parse($json.stdout) } }}"
      },
      "id": "review",
      "name": "Human Review Required",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1040,
        380
      ]
    }
  ],
  "connections": {
    "Regression Suite": {
      "main": [
        [
          {
            "node": "Offline Regression Evaluation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Offline Regression Evaluation": {
      "main": [
        [
          {
            "node": "Release Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Release Gate": {
      "main": [
        [
          {
            "node": "Approved",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Human Review Required",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "3d3f73ef-9ccb-44a9-9832-6ed3a65e207a"
}

